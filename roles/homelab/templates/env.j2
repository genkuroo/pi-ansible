{# Rendered by Ansible (homelab role). Values come from the vault, so change
   them there, not on the Pi: the next run puts the vault value back.
   Layout copied byte for byte from the hand-made file it replaced. #}
# Copy to .env on the Pi and fill in. .env is gitignored — it holds secrets.

# ---- The domain you registered at Cloudflare ----------------------------
# Everything public is served as a subdomain of this. Change it in one place
# and Caddy, cloudflared and the app configs all follow.
DOMAIN={{ homelab_env.DOMAIN }}

# ---- Timezone -----------------------------------------------------------
# IMPORTANT: Pi OS ships as UTC. The stock jobs are pegged to US market close,
# so leaving this unset would fire the "4pm" refresh at 9am Pacific.
TZ={{ homelab_env.TZ }}

# ---- Secrets ------------------------------------------------------------
# Used by stock-tracker's weekly AI TLDR (Claude Haiku 4.5).
ANTHROPIC_API_KEY={{ homelab_env.ANTHROPIC_API_KEY }}

# Token from `cloudflared tunnel token <tunnel-name>`, or leave blank if you
# run cloudflared with a credentials file instead (see cloudflared/config.yml).
CLOUDFLARE_TUNNEL_TOKEN={{ homelab_env.CLOUDFLARE_TUNNEL_TOKEN }}

# Flask session signing key for the D&D tracker. Generate once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs everyone out; it must NOT be regenerated on each deploy.
DND_SECRET_KEY={{ homelab_env.DND_SECRET_KEY }}
DND_STAGING_SECRET_KEY={{ homelab_env.DND_STAGING_SECRET_KEY }}

# ---- Sleeper → Discord bot ---------------------------------------------
# Bot token from discord.com/developers/applications → Bot → Reset Token.
# Treat like a password: it lets anyone act as the bot in your server.
DISCORD_TOKEN={{ homelab_env.DISCORD_TOKEN }}

# Server and channel ids. Enable Developer Mode in Discord (Settings →
# Advanced), then right-click the server / the channel → Copy ID.
DISCORD_GUILD_ID={{ homelab_env.DISCORD_GUILD_ID }}
DISCORD_CHANNEL_ID={{ homelab_env.DISCORD_CHANNEL_ID }}

# The long number in sleeper.com/leagues/<THIS>/team, or run:
#   python3 ../sleeper-discord-bot/scripts/find_league_id.py <username>
SLEEPER_LEAGUE_ID={{ homelab_env.SLEEPER_LEAGUE_ID }}

# Optional. Failed waiver claims are noisy on a contested player, so they are
# suppressed unless you set this to 1.
SLEEPER_POLL_SECONDS={{ homelab_env.SLEEPER_POLL_SECONDS }}
SLEEPER_ALERT_FAILED_WAIVERS={{ homelab_env.SLEEPER_ALERT_FAILED_WAIVERS }}

# Which Sleeper leagues the trade analyzer tracks (id:label pairs).
FFTA_LEAGUES={{ homelab_env.FFTA_LEAGUES }}

# ---- Off-site backup to Cloudflare R2 -----------------------------------
# Only ff-trade-analyzer is uploaded; fitness and stock data stay on the Pi.
R2_ACCOUNT_ID={{ homelab_env.R2_ACCOUNT_ID }}
R2_ACCESS_KEY_ID={{ homelab_env.R2_ACCESS_KEY_ID }}
R2_SECRET_ACCESS_KEY={{ homelab_env.R2_SECRET_ACCESS_KEY }}
R2_BUCKET={{ homelab_env.R2_BUCKET }}
R2_PREFIX={{ homelab_env.R2_PREFIX }}

# Shared password for the public fantasy.<domain> site (bcrypt).
FFTA_AUTH_USER={{ homelab_env.FFTA_AUTH_USER }}
# NOTE: every $ is doubled. Compose interpolates .env values, so a raw
# bcrypt hash gets its $-delimited fields eaten as undefined variables and
# arrives corrupted -- which fails as a silent 401, not an error.
FFTA_AUTH_HASH={{ homelab_env.FFTA_AUTH_HASH }}

DISCORD_ALERT_WEBHOOK={{ homelab_env.DISCORD_ALERT_WEBHOOK }}
