{# Rendered by Ansible (jobagent role). Secrets come from the vault, so change
   them there, not on the Pi: the next run puts the vault's value back.
   The layout copies the hand-made file it replaced, byte for byte. #}
# Copy to ~/.config/jobagent/env and `chmod 600` it. Never commit the real file.

# --- Claude Code (subscription) ---------------------------------------------
# Run `claude setup-token` once on the Pi and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN={{ jobagent_secrets.CLAUDE_CODE_OAUTH_TOKEN }}
CLAUDE_BIN={{ jobagent_home }}/.local/bin/claude
# Optional: pin a model, e.g. claude-sonnet-5
CLAUDE_MODEL={{ jobagent_claude_model }}

# --- Google Sheet (read-only) -----------------------------------------------
GOOGLE_SHEET_ID={{ jobagent_secrets.GOOGLE_SHEET_ID }}
GOOGLE_APPLICATION_CREDENTIALS={{ jobagent_conf_dir }}/google-sa.json

# --- Discord (one private channel per list) ---------------------------------
DISCORD_WEBHOOK_SRE={{ jobagent_secrets.DISCORD_WEBHOOK_SRE }}
DISCORD_WEBHOOK_IT={{ jobagent_secrets.DISCORD_WEBHOOK_IT }}

# --- Letter header --------------------------------------------------------------
CONTACT_NAME={{ jobagent_secrets.CONTACT_NAME }}
CONTACT_LOCATION={{ jobagent_secrets.CONTACT_LOCATION }}
CONTACT_PHONE={{ jobagent_secrets.CONTACT_PHONE }}
CONTACT_EMAIL={{ jobagent_secrets.CONTACT_EMAIL }}
CONTACT_LINKEDIN={{ jobagent_secrets.CONTACT_LINKEDIN }}
CONTACT_GITHUB={{ jobagent_secrets.CONTACT_GITHUB }}

# --- Limits (defaults shown) ------------------------------------------------
CHROMIUM_BIN=chromium
JOBAGENT_DATA_DIR={{ jobagent_home }}/.local/share/jobagent
JOBAGENT_MAX_AGE_DAYS={{ jobagent_max_age_days }}
JOBAGENT_MAX_ACTIVE={{ jobagent_max_active }}
JOBAGENT_MAX_NEW_PER_RUN={{ jobagent_max_new_per_run }}
JOBAGENT_DISK_BUDGET_MB={{ jobagent_disk_budget_mb }}
JOBAGENT_MIN_SCORE={{ jobagent_min_score }}

# alerts + daily summary
DISCORD_WEBHOOK_STATUS={{ jobagent_secrets.DISCORD_WEBHOOK_STATUS }}
HEALTHCHECK_URL_WATCHLIST={{ jobagent_secrets.HEALTHCHECK_URL_WATCHLIST }}
HEALTHCHECK_URL_SCOUT={{ jobagent_secrets.HEALTHCHECK_URL_SCOUT }}
JOBAGENT_DAILY_LETTER_CAP={{ jobagent_daily_letter_cap }}
JOBAGENT_DAILY_SCOUT_CAP={{ jobagent_daily_scout_cap }}

# board-check tests this address (set by setup-domain.sh)
JOBAGENT_BOARD_URL={{ jobagent_secrets.JOBAGENT_BOARD_URL }}
